# Backend Environment Variables (Render)
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.yourmongo.mongodb.net/lifeos?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_64_character_string
CLIENT_ORIGIN=https://your-lifeos-app.vercel.app

# Frontend Environment Variables (Vercel)
# Note: In Vite apps, environment variables must start with VITE_
VITE_API_URL=https://your-backend-service.onrender.com/api